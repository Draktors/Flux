{
  "name": "flux",
  "productName": "Flux",
  "version": "0.1.0",
  "private": true,
  "description": "Poste de pilotage du flux tiré",
  "main": "out/main/index.js",
  "scripts": {
    "build:native": "mkdir -p native/build && clang++ -std=c++17 -ObjC++ -fobjc-arc -O2 -bundle -undefined dynamic_lookup -arch arm64 -arch x86_64 -mmacosx-version-min=12.0 -DNODE_GYP_MODULE_NAME=notifications -I node_modules/node-api-headers/include -framework Foundation -framework UserNotifications native/notifications.mm -o native/build/notifications.node",
    "dev": "pnpm build:native && electron-vite dev",
    "build": "pnpm build:native && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package": "pnpm build && electron-builder --mac --dir",
    "install-app": "sh scripts/install-app.sh"
  },
  "build": {
    "appId": "io.github.lacaux-gerome.flux",
    "productName": "Flux",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "native/build/notifications.node",
        "to": "notifications.node"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Flux ouvre, sélectionne et ferme les workspaces cmux de tes threads."
      }
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ical-expander": "^3.2.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.36.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "node-api-headers": "1.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
