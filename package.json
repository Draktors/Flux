{
  "name": "flux",
  "productName": "Flux",
  "version": "0.1.0",
  "private": true,
  "description": "Poste de pilotage du flux tiré",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --mac --dir",
    "install-app": "pnpm package && rm -rf /Applications/Flux.app && cp -R dist/mac-arm64/Flux.app /Applications/ && codesign --force --deep --sign - /Applications/Flux.app"
  },
  "build": {
    "appId": "io.github.lacaux-gerome.flux",
    "productName": "Flux",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Flux ouvre, sélectionne et ferme les workspaces cmux de tes threads."
      }
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "ical-expander": "^3.2.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.36.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
